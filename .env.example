# Environment Configuration Template for Ghost Data Still Exists
# Copy this file to .env and supply actual keys if needed.
# NEVER commit real API keys, secrets, or credentials to version control.

# Local Paths
DATASET_DIR=dataset
OUTPUT_PATH=output.csv

# Optional LLM / VLM API Providers (for unstructured document analysis)
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Runtime Settings
LOG_LEVEL=INFO
